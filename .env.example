# identifier is appended to the username for you. Use a password or an SSH key.
# PTERO_SFTP_USER=myuser
# PTERO_SFTP_PASSWORD=
# PTERO_SFTP_KEY_FILE=
# PTERO_SFTP_PASSPHRASE=
